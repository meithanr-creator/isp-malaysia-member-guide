<section class="page interest-form"><%= link_to event_path(@event), class: "back" do %><%= isp_icon "arrow-left" %>Back to event<% end %><span class="eyebrow">Make a connection</span><h1>Register your interest.</h1><div class="interest-event-context"><span class="sample-label">Sample <%= @event.published_data["format"] %></span><h2><%= @event.published_title %></h2><p><%= event_date(@event.published_data) %> · <%= event_fee(@event.published_data) %></p></div><%= render "shared/errors", record: @interest %><%= form_with model: @interest, url: event_interest_path(@event), method: :post do |form| %><label class="field">Your name<%= form.text_field :name, required: true, maxlength: 80 %></label><label class="field">Email address<%= form.email_field :email, required: true, maxlength: 160 %></label><label class="field">Organisation<%= form.text_field :company, maxlength: 120 %></label><p class="form-hint">This saves sample interest only. It does not book a place, collect payment or notify ISP.</p><%= form.submit "Save my demo interest", class: "primary full" %><% end %></section>

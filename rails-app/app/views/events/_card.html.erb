<% data = event.published_data %><article class="public-event-card"><%= image_tag event_cover(data, event: event), alt: "", loading: "lazy" %><div class="event-card-copy"><div class="event-card-top"><span class="sample-label">Sample <%= data["format"] %></span><span class="fee-tag"><%= data["admission"] == "free" ? "Free" : "RM #{number_with_precision(data['fee'], precision: 0)}" %></span></div><h2><%= link_to data["title"], event_path(event) %></h2><p><%= data["summary"] %></p><div class="event-card-facts"><span><%= isp_icon "calendar3" %><%= event_date(data) %></span><span><%= isp_icon "geo-alt" %><%= data["venue"] %></span></div><%= link_to event_path(event), class: "secondary full" do %>View event <%= isp_icon "chevron-right" %><% end %></div></article>

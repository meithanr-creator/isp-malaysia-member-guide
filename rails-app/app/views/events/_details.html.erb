<section class="page public-event-detail" data-event-revision="<%= preview ? event.preview_revision : event.published_revision %>">
  <% unless preview %><%= link_to events_path, class: "back" do %><%= isp_icon "arrow-left" %>All events<% end %><% end %>
  <span class="eyebrow"><%= preview ? "Event preview" : (demo_mode? ? "Sample event" : "Event") %> · <%= data["format"] %></span><h1><%= data["title"] %></h1><p class="event-lead"><%= data["summary"] %></p>
  <div class="event-detail-image"><%= image_tag event_cover(data, event: event), alt: "Event illustration" %></div>
  <div class="event-fact-list"><div><%= isp_icon "calendar3" %><span><b><%= event_date(data) %></b><%= event_time(data["starts_at"]) %>–<%= event_time(data["ends_at"]) %><small><%= event_timezone(data) %></small></span></div><div><%= isp_icon "geo-alt" %><span><b><%= data["venue"] %></b><small><%= data["venue_details"] %></small></span></div><div><%= isp_icon "people-fill" %><span><b><%= event_fee(data) %></b><small><%= data["admission"] == "free" ? "No payment required." : "Payment instructions below. Interest does not reserve a place." %></small></span></div></div>
  <% if preview %><p class="preview-inline-note">This is how the event will appear publicly. Interest becomes available after publication.</p>
  <% elsif @interest %><div class="interest-confirmation"><%= isp_icon "calendar3" %><div><b><%= demo_mode? ? "Your demo interest is saved" : "Your interest is saved" %></b><span>You can review it from the top-right Dashboard.</span></div></div>
  <% else %><%= link_to new_event_interest_path(event), class: "primary full" do %><%= current_user ? "Register interest" : "Login to register interest" %><%= isp_icon "chevron-right" %><% end %><% end %>
  <% if !preview && demo_mode? %><p class="prototype-note">Sample event · interest is recorded in this local demo only.</p><% end %>
  <div class="event-editorial"><section><h2>About this event</h2><p class="preserve-lines"><%= data["description"] %></p></section><% if data["audience"].present? %><section><h2>Who is it for?</h2><p><%= data["audience"] %></p></section><% end %><% if data["programme"].present? %><section><h2>The programme</h2><p class="programme-lines preserve-lines"><%= data["programme"] %></p></section><% end %>
    <% if data.fetch("images", []).size > 1 %><div class="event-gallery"><% data["images"].drop(1).each do |image| %><%= image_tag event_file_url(image, event: event), alt: image["name"], loading: "lazy" %><% end %></div><% end %>
    <% if data["brochure"].present? %><section class="brochure-card"><%= isp_icon "file-earmark-text" %><div><h2>Event brochure</h2><p><%= data["brochure"]["name"] %></p><%= link_to event_file_url(data["brochure"], event: event), target: "_blank", rel: "noopener", class: "link-button" do %>Open PDF brochure <%= isp_icon "chevron-right" %><% end %><small>Opens the local file in a new tab</small></div></section><% end %>
    <% if data["admission"] == "paid" %><section class="event-payment"><span class="eyebrow">Payment information<%= " · sample only" if demo_mode? %></span><h2>Plan your place</h2><p class="payment-total"><%= event_fee(data) %></p><% if data["payment_method"] == "bank" %><dl class="payment-details"><% [["Bank", "bank_name"], ["Account name", "account_name"], ["Account number", "account_number"]].each do |label, field| %><div><dt><%= label %></dt><dd><%= data[field] %></dd></div><% end %></dl><% else %><p>Payment arrangements are confirmed by the organiser.</p><% end %><p class="small preserve-lines"><%= data["payment_notes"] %></p><%= link_to receipt_email_link(data), class: "secondary full" do %>Prepare receipt email <%= isp_icon "chevron-right" %><% end %><p class="form-hint">Opens your email app with a draft to <%= data["receipt_email"] %>. You attach your receipt and choose whether to send it. No email is sent here.</p></section><% end %>
  </div>
</section>


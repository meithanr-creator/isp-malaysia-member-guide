<%= form_with url: destination, method: :patch, class: "signin-form", data: { controller: "account-token", turbo: false } do |form| %>
  <%= form.hidden_field :token, value: @token, data: { account_token_target: "token" } %>
  <p class="form-hint" data-account-token-target="status" role="status">Open the complete link from your ISP email to continue.</p>
  <noscript><p>JavaScript is required to open this private email link. Enable it and reopen the link, or contact ISP through your usual trusted contact. Your password has not been changed.</p></noscript>
  <label class="field">New password<%= form.password_field :password, required: true, minlength: 12, maxlength: 72, autocomplete: "new-password" %></label>
  <label class="field">Confirm password<%= form.password_field :password_confirmation, required: true, minlength: 12, maxlength: 72, autocomplete: "new-password" %></label>
  <p class="form-hint">Use at least 12 characters. A password manager can create and save a strong password.</p>
  <button type="submit" class="primary full" data-account-token-target="submit" disabled><%= button_text %></button>
<% end %>

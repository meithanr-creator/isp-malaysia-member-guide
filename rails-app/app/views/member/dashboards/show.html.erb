<section class="page member-home"><span class="eyebrow">Your member space</span><h1>Hello, <%= current_user.name.split.first %>.</h1><p class="intro">Your next connection starts here.</p>
  <article class="profile-card"><div class="profile-heading"><span class="avatar"><%= current_user.name.split.map(&:first).first(2).join %></span><div><h2><%= current_user.name %></h2><p>Member profile</p></div></div><dl class="profile-details"><% [["Email", current_user.email], ["Organisation", current_user.company], ["Branch", current_user.branch], ["Telephone", current_user.phone]].each do |label, value| %><div><dt><%= label %></dt><dd><%= value.presence || "Not added" %></dd></div><% end %></dl><%= link_to edit_member_profile_path, class: "link-button" do %>Edit your profile <%= isp_icon "chevron-right" %><% end %></article>
  <section class="member-interests"><div class="section-head"><h2>Your event interests</h2><span class="count-badge"><%= @interests.size %></span></div><% if @interests.empty? %><div class="empty-state"><%= isp_icon "calendar3" %><h3>Something to look forward to.</h3><p>Explore an event and save your interest. You will find it here.</p><%= link_to events_path, class: "secondary full" do %>Explore events <%= isp_icon "chevron-right" %><% end %></div><% else %><% @interests.each do |interest| %><% data = interest.event_snapshot.presence || interest.event.published_data %><article class="interest-card"><span class="sample-label">Interest saved · demo</span><h3><%= data["title"] %></h3><p><%= event_date(data) %> · <%= data["venue"] %></p><p class="form-hint"><%= interest.name %> · <%= interest.email %><br>Saved against event version <%= interest.event_revision %>. Check the current event for any updates.</p><div class="interest-actions"><%= link_to "View current event", event_path(interest.event), class: "link-button" %><%= button_to "Withdraw", event_interest_path(interest.event), method: :delete, class: "link-button quiet-action", data: { turbo_confirm: "Withdraw your saved demo interest?" } %></div></article><% end %><% end %></section>
  <div class="member-legacy"><h2>Keep your journey growing</h2><%= link_to member_publications_path, class: "service-row" do %><%= isp_icon "journal-bookmark" %><span>Read The Planter<small>Your member library</small></span><%= isp_icon "chevron-right" %><% end %></div>
</section>

<section class="page consultation-page">
  <%= link_to "Back to consultation", member_consultation_requests_path, class: "back" %>
  <span class="eyebrow">Member enquiry</span><h1>How can ISP help?</h1><p class="intro">Share the context and the question you would like to explore. This is an enquiry, with no booking or payment.</p>
  <%= render "shared/errors", record: @consultation_request %>
  <%= form_with model: [:member, @consultation_request] do |form| %>
    <%= form.hidden_field :request_key %>
    <label class="field">Area of enquiry<%= form.select :category, ConsultationRequest::TOPICS, { prompt: "Choose an area" }, required: true %></label>
    <label class="field">Subject<%= form.text_field :subject, required: true, maxlength: 140, placeholder: "A brief summary of your question" %></label>
    <label class="field">Your question<%= form.text_area :message, required: true, maxlength: 5000, rows: 8, placeholder: "Describe your situation, location and the support you are looking for." %><small>Up to 5,000 characters.</small></label>
    <p class="form-hint">Submitted as <strong><%= current_user.name %></strong> · <%= current_user.email %></p>
    <%= form.submit "Send enquiry", class: "primary full", data: { turbo_submits_with: "Sending…" } %>
  <% end %>
</section>

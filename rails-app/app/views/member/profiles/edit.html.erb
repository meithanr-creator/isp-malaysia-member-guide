<section class="page profile-edit"><span class="eyebrow">Your member profile</span><h1>Make yourself at home.</h1><p class="intro">Keep your sample details up to date.</p><%= render "shared/errors", record: current_user %><%= form_with model: current_user, url: member_profile_path do |form| %><label class="field">Full name<%= form.text_field :name, required: true, maxlength: 80 %></label><label class="field">Email address<%= form.email_field :email, disabled: true %><small>Your login address is managed separately.</small></label><label class="field">Organisation<%= form.text_field :company, maxlength: 120 %></label><label class="field">Branch<%= form.text_field :branch, maxlength: 100 %></label><label class="field">Telephone<%= form.telephone_field :phone, maxlength: 40 %></label><div class="stack"><%= form.submit "Save sample profile", class: "primary full" %><%= link_to "Cancel", member_dashboard_path, class: "text-action full" %></div><p class="form-hint">Use fictional information. Changes are saved in this local Rails demo.</p><% end %></section>

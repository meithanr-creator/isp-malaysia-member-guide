<% content_for :title, "Upload membership list | ISP" %>
<section class="page membership-admin">
  <%= link_to "Membership list", admin_membership_registry_entries_path, class: "back" %>
  <span class="eyebrow">Administration · membership authority</span>
  <h1>Review your membership list.</h1>
  <p class="intro">Upload a list, check the private preview, then confirm the exact changes.</p>
  <% if demo_mode? %><div class="admin-demo-note">Prepare this local preview with fictional membership records.</div><% end %><p class="form-hint">Importing a list does not activate accounts or send invitations.</p>
  <%= form_with url: admin_membership_imports_path, scope: :membership_import, multipart: true, data: { turbo: false } do |form| %>
    <label class="upload-area" for="membership-import-csv"><b>Choose membership CSV</b><span>UTF-8 CSV · up to 2 MB · 5,000 membership rows</span><%= form.file_field :csv, id: "membership-import-csv", accept: ".csv,text/csv", required: true, aria: { describedby: "membership-csv-help" } %></label>
    <div id="membership-csv-help" class="form-hint">
      <p>Use exactly these four column headers, in this order:</p>
      <p><code>name,email,member_reference,status</code></p>
      <p>Status must be <strong>eligible</strong> or <strong>ineligible</strong>. Keep membership references as text so leading zeros survive. Administrator roles, passwords and extra columns are rejected.</p>
      <p>Existing references and emails must stay paired. Only listed rows are added or updated; omitted memberships are preserved. An ineligible linked member is suspended and signed out. Making someone eligible again does not reactivate their account.</p>
    </div>
    <%= form.submit "Create private preview", class: "primary full" %>
  <% end %>
</section>


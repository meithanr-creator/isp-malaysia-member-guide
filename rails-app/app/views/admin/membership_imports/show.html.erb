<% content_for :title, "Membership import preview | ISP" %>
<section class="page membership-admin">
  <%= link_to "Membership list", admin_membership_registry_entries_path, class: "back" %>
  <span class="eyebrow">Private membership preview</span>
  <h1><%= @import.confirmed? ? "Membership list confirmed." : "Check before confirming." %></h1>
  <p class="intro"><%= @import.counts.fetch("total", 0) %> rows · <%= @import.counts.fetch("add", 0) %> additions · <%= @import.counts.fetch("update", 0) %> updates · <%= @import.counts.fetch("unchanged", 0) %> unchanged · <%= @import.counts.fetch("invalid", 0) %> invalid</p>
  <% if @import.confirmed? %>
    <div class="admin-demo-note" role="status">Confirmed <%= @import.confirmed_at.in_time_zone("Asia/Kuala_Lumpur").strftime("%-d %b %Y, %H:%M") %>. Membership changes were saved together. No accounts were activated and no invitations were sent.</div>
    <p class="form-hint">Import record: <%= @import.public_id %></p>
  <% elsif @import.state == "expired" %>
    <div class="validation-errors" role="alert">This preview expired. Its private row data has been removed. Upload a fresh list to continue.</div>
  <% else %>
    <p class="form-hint">Preview expires <%= @import.expires_at.in_time_zone("Asia/Kuala_Lumpur").strftime("%H:%M") %> (Malaysia time). Membership or account changes require a new preview.</p>
    <% if @import.validation_errors.any? %>
      <div class="validation-errors" role="alert"><h2>Correct the CSV and upload again.</h2><p><%= @import.validation_errors.length %> validation issues. Nothing has been imported.</p><ul><% @import.validation_errors.first(25).each do |error| %><li><%= error %></li><% end %></ul><% if @import.validation_errors.length > 25 %><p>More issues are shown beside the affected rows below.</p><% end %></div>
    <% end %>
    <% if @rows.any? %><ol class="membership-row-list" aria-label="Reviewed CSV rows" start="<%= (@page - 1) * 50 + 1 %>">
      <% @rows.each do |row| %><li class="membership-row">
        <p class="eyebrow">CSV row <%= row["row_number"] %> · <%= { "add" => "Addition", "update" => "Update", "unchanged" => "Unchanged", "invalid" => "Needs correction" }.fetch(row["action"]) %></p>
        <h2><%= row["name"] %></h2>
        <dl class="membership-details"><div><dt>Email</dt><dd><%= row["email"] %></dd></div><div><dt>Membership reference</dt><dd><%= row["member_reference"] %></dd></div><div><dt>Eligibility</dt><dd><%= row["status"] %></dd></div></dl>
        <% if row["errors"].any? %><ul class="membership-row-errors"><% row["errors"].each do |error| %><li><%= error %></li><% end %></ul><% end %>
      </li><% end %>
    </ol><% end %>
    <% if @page_count > 1 %><nav class="membership-pagination" aria-label="Preview pages"><% if @page > 1 %><%= link_to "Previous 50 rows", admin_membership_import_path(@import, page: @page - 1), class: "link-button" %><% end %><span>Page <%= @page %> of <%= @page_count %></span><% if @page < @page_count %><%= link_to "Next 50 rows", admin_membership_import_path(@import, page: @page + 1), class: "link-button" %><% end %></nav><% end %>
    <% if @import.ready? %>
      <div class="editor-footer">
        <p>Confirming saves all reviewed rows together. Omitted memberships are preserved. Ineligible linked members are suspended and signed out; re-eligibility does not restore account access.</p>
        <%= form_with url: confirm_admin_membership_import_path(@import), data: { turbo: false } do |form| %>
          <%= hidden_field_tag :digest, @import.digest %><%= hidden_field_tag :registry_version, @import.registry_version %>
          <%= form.submit "Confirm this membership list", class: "primary full" %>
        <% end %>
      </div>
    <% end %>
  <% end %>
  <p><%= link_to "Upload another list", new_admin_membership_import_path, class: "link-button" %></p>
</section>


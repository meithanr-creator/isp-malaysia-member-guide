<section class="page account-login"><span class="eyebrow">Administrator verification</span><h1>Verify before making changes.</h1><p class="intro">Enter your password and an unused authenticator code. Your open editor and sign-in stay available.</p><section class="signin-panel"><%= form_with url: admin_verification_path, class: "signin-form", data: { turbo: false } do |form| %><label class="field">Password<%= form.password_field :password, required: true, maxlength: 72, autocomplete: "current-password" %></label><label class="field">Authenticator code<%= form.text_field :otp_code, required: true, maxlength: 6, inputmode: "numeric", autocomplete: "one-time-code" %></label><button class="primary full" type="submit">Verify administrator access</button><% end %><p class="form-hint">Verification lasts ten minutes for saving drafts, payment instructions and publishing. If your original form is open in another tab, return there after verification. Files may need to be selected again after a rejected save.</p></section></section>

<%= render "shared/admin_verification_notice" %>
<div class="admin-preview"><%= render "shared/steps", active: 1 %><div class="preview-banner"><span class="status-badge">Preview · revision <%= @event.preview_revision %></span><p>Review the public event below. Publish this exact version when every detail feels right.</p><div class="preview-actions"><%= link_to "Edit draft", edit_admin_event_path(@event), class: "secondary" %><%= button_to(demo_mode? ? "Publish in demo" : "Publish event", publish_admin_event_path(@event), params: { revision: @event.preview_revision }, class: "primary", data: { turbo_confirm: demo_mode? ? "Publish this reviewed version in the local demo?" : "Publish this exact reviewed event to the public website?" }) %></div></div><%= render "events/details", event: @event, data: @data, preview: true %><div class="preview-bottom"><%= link_to "Edit draft", edit_admin_event_path(@event), class: "secondary" %><%= button_to(demo_mode? ? "Publish in demo" : "Publish event", publish_admin_event_path(@event), params: { revision: @event.preview_revision }, class: "primary") %></div></div>

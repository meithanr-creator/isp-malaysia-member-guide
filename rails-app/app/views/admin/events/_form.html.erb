<% data = @event.draft_data || {} %>
<section class="page event-editor"><%= link_to admin_events_path, class: "back" do %><%= isp_icon "arrow-left" %>Admin workspace<% end %><%= render "shared/steps", active: 0 %><span class="eyebrow">Event editor · local draft</span><h1><%= @event.published? ? "A fresh version." : "Make room for a new idea." %></h1><p class="intro">Create the invitation. Then see how it feels.</p><p class="revision-caption">Revision <%= @event.revision %> · Saving any edit requires a fresh preview.</p><% if @event.published? %><p class="published-draft-note">The public event keeps its published version while you work on this draft.</p><% end %>
<%= render "shared/errors", record: @event %>
<%= form_with scope: :event, url: @event.persisted? ? admin_event_path(@event) : admin_events_path, method: @event.persisted? ? :patch : :post, multipart: true, data: { controller: "event-editor", action: "input->event-editor#dirty change->event-editor#dirty" } do |form| %>
  <%= form.hidden_field :lock_version, value: @event.lock_version %>
  <fieldset class="editor-section"><legend><span>01</span> The invitation</legend>
    <label class="field">Event title *<%= form.text_field :title, value: data["title"], required: true, maxlength: 110, placeholder: "e.g. Plantation Leadership Exchange" %></label>
    <label class="field">Format *<%= form.select :format, Event::FORMATS, selected: data["format"] %></label>
    <label class="field">A short introduction *<%= form.text_field :summary, value: data["summary"], required: true, maxlength: 180, placeholder: "One clear reason to be there" %></label>
    <label class="field">About the event *<%= form.text_area :description, value: data["description"], required: true, maxlength: 4000, rows: 5, placeholder: "What will people discover, discuss or take away?" %></label>
    <label class="field">Who is it for?<%= form.text_field :audience, value: data["audience"], maxlength: 240 %></label>
    <label class="field">Programme<%= form.text_area :programme, value: data["programme"], maxlength: 2500, rows: 5, placeholder: "09:00 · Welcome\n09:30 · First session" %></label>
  </fieldset>
  <fieldset class="editor-section"><legend><span>02</span> A time and a place</legend>
    <label class="field">Event date *<%= form.date_field :date, value: data["date"], required: true %></label>
    <div class="field-pair"><label class="field">Starts *<%= form.time_field :starts_at, value: data["starts_at"].presence || "09:00", required: true %></label><label class="field">Ends *<%= form.time_field :ends_at, value: data["ends_at"].presence || "17:00", required: true %></label></div>
    <label class="field">Time zone *<%= form.select :timezone, Event::TIMEZONES.map { |zone| [event_timezone({"timezone" => zone}), zone] }, selected: data["timezone"] %></label>
    <label class="field">Venue or online location *<%= form.text_field :venue, value: data["venue"], required: true, maxlength: 180, placeholder: "Venue name and city, or Online" %></label>
    <label class="field">Location details<%= form.text_area :venue_details, value: data["venue_details"], maxlength: 700, rows: 3, placeholder: "Address, meeting point or joining instructions" %></label>
  </fieldset>
  <fieldset class="editor-section"><legend><span>03</span> Show what is ahead</legend><p class="form-hint">Preview files before saving. They stay in this local Rails demo.</p>
    <label class="upload-area"><%= isp_icon "plus-lg" %><b>Add event images</b><span>JPG, PNG or WebP · up to 3 images · 5 MB each</span><%= form.file_field :images, multiple: true, accept: "image/jpeg,image/png,image/webp", data: { event_editor_target: "imageInput", action: "change->event-editor#images" } %></label>
    <div class="existing-images" data-event-editor-target="existingImages" data-image-count="<%= data.fetch('images', []).size %>"><% data.fetch("images", []).each_with_index do |image, index| %><div class="upload-preview"><%= image_tag event_file_url(image, event: @event), alt: image["name"] %><div><b><%= index.zero? ? "Cover image" : "Gallery image" %></b><small><%= image["name"] %></small><label class="check"><%= check_box_tag "event[remove_images][]", index, false %>Remove on save</label></div></div><% end %></div>
    <div data-event-editor-target="imagePreview" class="local-image-previews"></div>
    <label class="upload-area"><%= isp_icon "file-earmark-text" %><b>Add a PDF brochure</b><span>One PDF · up to 10 MB</span><%= form.file_field :brochure, accept: "application/pdf,.pdf", data: { event_editor_target: "brochureInput", action: "change->event-editor#brochure" } %></label>
    <% if data["brochure"].present? %><div class="file-preview"><%= isp_icon "file-earmark-text" %><div><b><%= data["brochure"]["name"] %></b><%= link_to "Open saved PDF", event_file_url(data["brochure"], event: @event), target: "_blank", rel: "noopener", class: "link-button" %><label class="check"><%= form.check_box :remove_brochure %>Remove on save</label></div></div><% end %>
    <div data-event-editor-target="brochurePreview"></div><p class="form-status" role="status" data-event-editor-target="uploadStatus"></p>
  </fieldset>
  <fieldset class="editor-section"><legend><span>04</span> Fees and payment</legend>
    <label class="field">Admission *<%= form.select :admission, [["Free event", "free"], ["Paid event", "paid"]], { selected: data["admission"] }, data: { event_editor_target: "admission", action: "change->event-editor#payment" } %></label>
    <div data-event-editor-target="paid"><p class="form-hint">Use fictional bank details and an example email address in this demo.</p>
      <label class="field">Fee per person (RM) *<%= form.number_field :fee, value: data["fee"], min: "0.01", max: "100000", step: "0.01", data: { required_when_paid: true } %></label>
      <label class="field">Payment method *<%= form.select :payment_method, [["Bank transfer", "bank"], ["Arrange with organiser", "organiser"]], { selected: data["payment_method"] }, data: { event_editor_target: "paymentMethod", action: "change->event-editor#payment" } %></label>
      <div data-event-editor-target="bank"><label class="field">Bank name *<%= form.text_field :bank_name, value: data["bank_name"], maxlength: 100, placeholder: "Sample Bank", data: { required_when_bank: true } %></label><label class="field">Account name *<%= form.text_field :account_name, value: data["account_name"], maxlength: 140, placeholder: "ISP DEMO — DO NOT TRANSFER", data: { required_when_bank: true } %></label><label class="field">Account number *<%= form.text_field :account_number, value: data["account_number"], maxlength: 60, placeholder: "DEMO-0000-0000", data: { required_when_bank: true } %></label></div>
      <label class="field">Company receipt email *<%= form.email_field :receipt_email, value: data["receipt_email"], maxlength: 160, placeholder: "receipts@example.com", data: { required_when_paid: true } %></label>
      <label class="field">Payment instructions<%= form.text_area :payment_notes, value: data["payment_notes"], maxlength: 1200, rows: 3, placeholder: "How should participants prepare their payment and receipt?" %></label>
    </div>
  </fieldset>
  <div class="editor-footer"><p data-event-editor-target="draftStatus">Save your draft, then review the complete event before publication.</p><div class="stack"><button type="submit" name="intent" value="preview" class="primary full">Preview event <%= isp_icon "chevron-right" %></button><button type="submit" name="intent" value="draft" class="text-action full" formnovalidate>Save draft & close</button></div></div>
<% end %></section>

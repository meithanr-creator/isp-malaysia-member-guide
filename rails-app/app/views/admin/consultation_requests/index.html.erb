<section class="page consultation-page"><span class="eyebrow">Administration</span><h1>Consultation enquiries</h1><p class="intro">Read member questions and use their profile contact details to follow up. No automatic email is sent.</p>
<% if @requests.empty? %><div class="empty-state"><p>No enquiries have been received yet.</p></div><% else %><p class="form-hint">Most recent 100 enquiries.</p><% @requests.each do |query| %><%= link_to admin_consultation_request_path(query), class: "query-card" do %><span class="eyebrow"><%= query.reference %> · Received</span><h2><%= query.subject %></h2><p><%= query.user.name %> · <%= query.category %></p><small><%= query.created_at.in_time_zone("Asia/Kuala_Lumpur").strftime("%-d %b %Y") %></small><% end %><% end %><% end %>
</section>

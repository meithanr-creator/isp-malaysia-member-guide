<%= render "shared/admin_verification_notice" %>
<section class="page publication-admin">
  <%= link_to "Continue editing", edit_admin_publication_path(@publication), class: "back" %>
  <div class="publication-preview-note"><span class="eyebrow">Private preview</span><h2>Ready for the member library?</h2><p>Review the cover, description and PDF below. Publishing makes this exact version available to signed-in members.</p></div>
  <%= render "publications/detail", publication: @publication, data: @data, admin_preview: true %>
  <div class="publication-publish-actions"><%= button_to "Publish to members", publish_admin_publication_path(@publication), params: { revision: @publication.preview_revision, lock_version: @publication.lock_version }, class: "primary full" %><%= link_to "Edit this draft", edit_admin_publication_path(@publication), class: "text-action full" %></div>
</section>

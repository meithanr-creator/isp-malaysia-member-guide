<section class="page publication-admin">
  <span class="eyebrow">Administration</span><h1>The member bookshelf.</h1><p class="intro">Prepare an issue, review its cover and description, then publish it to members.</p>
  <%= link_to "Add a publication", new_admin_publication_path, class: "primary full" %>
  <div class="publication-list">
  <% if @publications.empty? %><div class="empty-state"><h2>A place for every issue.</h2><p>Upload your first PDF book and cover to start the member library.</p></div><% else %>
    <% @publications.each do |publication| %><article class="publication-admin-card">
      <span class="eyebrow"><%= publication.published? ? (publication.revision == publication.published_revision ? "Published to members" : "Published · draft changes") : "Private draft" %></span>
      <h2><%= publication.title %></h2><p class="form-hint">Updated <%= publication.updated_at.in_time_zone("Asia/Kuala_Lumpur").strftime("%-d %b %Y") %></p>
      <%= link_to "Edit publication", edit_admin_publication_path(publication), class: "link-button" %>
    </article><% end %>
  <% end %></div>
</section>

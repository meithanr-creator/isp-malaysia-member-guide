<%= render "shared/errors", record: publication %>
<%= form_with model: [:admin, publication], class: "publication-form" do |form| %>
  <%= form.hidden_field :lock_version %>
  <fieldset><legend>The publication</legend>
    <label class="field">Title<%= form.text_field :title, value: publication.draft_data["title"], maxlength: 160 %></label>
    <label class="field">Issue or subtitle<%= form.text_field :subtitle, value: publication.draft_data["subtitle"], maxlength: 200, placeholder: "For example, volume and issue number" %></label>
    <label class="field">Author or publisher<%= form.text_field :author, value: publication.draft_data["author"], maxlength: 140 %></label>
    <label class="field">Publication date<%= form.date_field :issue_date, value: publication.draft_data["issue_date"] %></label>
    <label class="field">Description<%= form.text_area :description, value: publication.draft_data["description"], maxlength: 4000, rows: 7 %><small>Introduce the issue and what members will learn. Up to 4,000 characters.</small></label>
  </fieldset>
  <fieldset><legend>Cover and PDF book</legend>
    <% cover = publication.draft_data["cover"] %>
    <% if cover.present? %><div class="publication-current-cover"><%= image_tag admin_publication_file_path(publication, "cover", cover["signed_id"], version: "draft"), alt: "Current draft cover" %><p><%= cover["name"] %></p></div><% end %>
    <label class="field">Cover image<%= form.file_field :cover, accept: "image/jpeg,image/png,image/webp" %><small>JPG, PNG or WebP · up to 5 MB. A portrait cover works best. Export HEIC photos to a supported format first.</small></label>
    <% if cover.present? %><label class="publication-checkbox"><%= form.check_box :remove_cover, checked: false %> Remove the draft cover</label><% end %>
    <% pdf = publication.draft_data["pdf"] %>
    <% if pdf.present? %><p class="form-hint">Current PDF: <%= pdf["name"] %> · <%= number_to_human_size(pdf["size"]) %></p><% end %>
    <label class="field">PDF book<%= form.file_field :pdf, accept: "application/pdf" %><small>PDF · up to 25 MB. Upload material ISP is authorised to share with its members.</small></label>
    <% if pdf.present? %><label class="publication-checkbox"><%= form.check_box :remove_pdf, checked: false %> Remove the draft PDF</label><% end %>
  </fieldset>
  <p class="form-hint">A title, description, PDF and cover are required before preview and publication. You can save an incomplete draft.</p>
  <div class="stack"><%= form.button "Save & preview", name: "intent", value: "preview", class: "primary full", data: { turbo_submits_with: "Saving…" } %><%= form.button "Save draft", name: "intent", value: "draft", class: "secondary full", data: { turbo_submits_with: "Saving…" } %></div>
<% end %>

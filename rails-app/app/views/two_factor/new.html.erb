<section class="page account-login"><span class="eyebrow">Administrator access</span><h1><%= @challenge.user.otp_enabled_at ? "Verify your sign-in." : "Set up your authenticator." %></h1><section class="signin-panel">
<% unless @challenge.user.otp_enabled_at %><p>Add this account to your authenticator app using the setup key below, then enter the current six-digit code. Keep this key private.</p><div class="field"><span class="auth-setup-key-label">Private setup key</span><code class="auth-setup-key"><%= @challenge.otp_secret %></code></div><p class="form-hint">Issuer: ISP Member Portal<br>Account: <%= @challenge.user.email %><br>Time based · six digits · 30-second interval</p><% end %>
<%= form_with url: two_factor_path, class: "signin-form", data: { turbo: false } do |form| %><label class="field"><%= @challenge.user.otp_enabled_at ? "Authenticator or unused recovery code" : "Authenticator code" %><%= form.text_field :otp_code, required: true, maxlength: 30, autocomplete: "one-time-code", autocapitalize: "off", spellcheck: false %></label><button class="primary full" type="submit">Verify and continue</button><% end %><p class="form-hint">This sign-in expires after five minutes. No administrator session opens until verification succeeds.</p><%= button_to "Cancel sign-in", two_factor_path, method: :delete, class: "text-action full" %></section></section>

<section class="page account-login"><%= link_to root_path, class: "back" do %><%= isp_icon "arrow-left" %>Home<% end %><span class="eyebrow">Your ISP community</span><h1>Welcome back.</h1><p class="intro">A place for your professional journey.</p>
  <% if session[:return_to].present? %><div class="return-context"><%= isp_icon "calendar3" %><span>Your requested page is waiting.<br><b>Login to continue where you left off.</b></span></div><% end %>
  <section class="signin-panel"><h2>Member login</h2><p class="form-hint">Use your email address and password to open your account.</p><%= form_with url: session_path, class: "signin-form" do |form| %><label class="field">Email address<%= form.email_field :email, required: true, maxlength: 160, autocomplete: "username", placeholder: "member@example.com" %></label><label class="field">Password<div class="password-wrap" data-controller="password"><%= form.password_field :password, required: true, maxlength: 128, autocomplete: "current-password", data: { password_target: "input" } %><button type="button" class="password-toggle" data-action="password#toggle" data-password-target="button" aria-pressed="false">Show</button></div></label><button type="submit" class="primary full">Sign in <%= isp_icon "chevron-right" %></button><% end %></section>
  <p class="form-hint"><%= link_to "Forgot your password?", password_recovery_path %></p>
  <% if demo_mode? %><section class="demo-entry"><span class="eyebrow">Explore this prototype</span><h2>Take a look around.</h2><p>Use a sample account to try the experience. No password needed.</p><div class="stack"><%= button_to demo_session_path, params: { role: "member" }, class: "secondary full" do %>Try member demo <%= isp_icon "chevron-right" %><% end %><%= button_to demo_session_path, params: { role: "admin" }, class: "text-action full" do %>Preview admin demo <%= isp_icon "chevron-right" %><% end %></div><p class="form-hint">This local Rails demo saves sample records on this computer. Use fictional information. No emails or payments are sent.</p></section><% end %>
</section>

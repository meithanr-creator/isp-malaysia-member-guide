<section class="page account-login"><%= link_to "Back to login", login_path, class: "back" %><span class="eyebrow">Your ISP account</span><h1>Reset your password.</h1><p class="intro">Enter the email address associated with your account.</p><% unless AccountMailer.enabled? %><p class="form-hint">Account email is not enabled in this environment. Use your usual trusted ISP contact for assistance. No reset email will be sent here.</p><% end %><section class="signin-panel"><%= form_with url: password_recovery_path, class: "signin-form" do |form| %><label class="field">Email address<%= form.email_field :email, required: true, maxlength: 160, autocomplete: "username" %></label><button class="primary full" type="submit">Request reset link</button><% end %></section></section>

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "isp-member-production",
  "account_id": "a9720867333b64a4f8ee70cdfd673eb9",
  "main": "src/index.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": { "enabled": false },
  "vars": {
    "ISP_CONTAINER_ENABLED": "false",
    "APP_HOST": "planterapp.co",
    "ISP_ACCOUNT_EMAILS_ENABLED": "false",
    "ISP_ACCOUNT_EMAIL_DISPATCHER_ENABLED": "false"
  },
  "containers": [{
    "class_name": "RailsContainer",
    "scheduling_policy": "default",
    "image": "../deployment/cloudflare/Dockerfile.runtime",
    "image_build_context": "..",
    "instance_type": "standard-2",
    "max_instances": 1,
    "observability": { "enabled": false }
  }],
  "durable_objects": {
    "bindings": [{ "name": "RAILS_CONTAINER", "class_name": "RailsContainer" }]
  },
  "migrations": [{ "tag": "rails-container-v1", "new_sqlite_classes": ["RailsContainer"] }]
}

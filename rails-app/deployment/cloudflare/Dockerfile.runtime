# syntax=docker/dockerfile:1
# Build from PROJECT ROOT: docker build --platform linux/amd64 -f deployment/cloudflare/Dockerfile.runtime -t isp-cloudflare .
ARG RUBY_VERSION=3.4.12
FROM ruby:${RUBY_VERSION}-slim AS clamav-package
RUN apt-get update -qq && apt-get install --no-install-recommends -y ca-certificates curl gnupg && rm -rf /var/lib/apt/lists/*
COPY deployment/cloudflare/cisco-talos.asc /tmp/cisco-talos.asc
RUN echo '5bfca75f112f04b89cd992f5f925018e8dfc28e0e7f6e33f6a4c33ed9e29d911  /tmp/cisco-talos.asc' | sha256sum -c - \
 && test "$(gpg --batch --with-colons --import-options show-only --import /tmp/cisco-talos.asc 2>/dev/null | awk -F: '$1 == "fpr" {print $10; exit}')" = '5BADCA2665EF59DCF8A23D8B707F0DB480836771' \
 && curl --proto '=https' --tlsv1.2 --fail --location --retry 2 --connect-timeout 10 --max-time 300 -o /tmp/clamav.deb https://github.com/Cisco-Talos/clamav/releases/download/clamav-1.4.6/clamav-1.4.6.linux.x86_64.deb \
 && curl --proto '=https' --tlsv1.2 --fail --location --retry 2 --connect-timeout 10 --max-time 60 -o /tmp/clamav.deb.sig https://github.com/Cisco-Talos/clamav/releases/download/clamav-1.4.6/clamav-1.4.6.linux.x86_64.deb.sig \
 && echo 'd3ee9e401974855a1edc1761b1425417d126de618d5f0c91cd51209f69f6fcc2  /tmp/clamav.deb' | sha256sum -c - \
 && echo '95bf86dad9b210164549a7369b6087d3f2e7f0976239e5693071bbae17406009  /tmp/clamav.deb.sig' | sha256sum -c - \
 && gpg --batch --import /tmp/cisco-talos.asc \
 && gpg --batch --no-auto-key-retrieve --verify /tmp/clamav.deb.sig /tmp/clamav.deb

FROM ruby:${RUBY_VERSION}-slim AS base
ARG TARGETARCH
WORKDIR /rails
RUN test "$TARGETARCH" = amd64
RUN --mount=type=bind,from=clamav-package,source=/tmp/clamav.deb,target=/tmp/clamav.deb,ro \
    apt-get update -qq && apt-get install --no-install-recommends -y ca-certificates libpq5 libvips tini /tmp/clamav.deb \
 && rm -rf /var/lib/apt/lists/* \
 && test "$(/usr/local/bin/clamscan --version | cut -d' ' -f2 | cut -d/ -f1)" = '1.4.6' \
 && /usr/local/sbin/clamd --version && /usr/local/bin/freshclam --version
ENV RAILS_ENV=production BUNDLE_DEPLOYMENT=1 BUNDLE_PATH=/usr/local/bundle BUNDLE_WITHOUT=development:test \
    CLAMD_HOST=127.0.0.1 CLAMD_PORT=3310 PORT=3000 TZ=Etc/UTC RAILS_LOG_TO_STDOUT=1

FROM base AS build
RUN apt-get update -qq && apt-get install --no-install-recommends -y build-essential git libpq-dev pkg-config && rm -rf /var/lib/apt/lists/*
COPY Gemfile Gemfile.lock ./
RUN bundle install && bundle exec bootsnap precompile --gemfile
COPY . .
RUN SECRET_KEY_BASE_DUMMY=1 bundle exec rails assets:precompile

FROM base AS runtime
RUN groupadd --system --gid 1000 rails \
 && useradd rails --uid 1000 --gid 1000 --create-home --shell /usr/sbin/nologin \
 && install -d -o rails -g rails -m 0700 /var/lib/clamav /var/tmp/clamav
COPY deployment/cloudflare/clamd.conf /etc/clamav/clamd.conf
COPY deployment/cloudflare/freshclam.conf /etc/clamav/freshclam.conf
# Preload public signed databases to avoid a full download on every cold start.
# Runtime still updates and checks age; a cached image is never evidence of freshness.
USER 1000:1000
RUN /usr/local/bin/freshclam --stdout --config-file=/etc/clamav/freshclam.conf
USER root
COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build --chown=root:root /rails /rails
RUN install -d -o rails -g rails /rails/tmp /rails/tmp/cache /rails/log /rails/storage \
 && chown -R rails:rails /rails/tmp /rails/log /rails/storage
USER 1000:1000
EXPOSE 3000
STOPSIGNAL SIGTERM
HEALTHCHECK --start-period=360s --interval=30s --timeout=25s --retries=3 CMD ["ruby", "/rails/deployment/cloudflare/supervisor.rb", "--check"]
ENTRYPOINT ["/usr/bin/tini", "--", "ruby", "/rails/deployment/cloudflare/supervisor.rb"]
CMD []

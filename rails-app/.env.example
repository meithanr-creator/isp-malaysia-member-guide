# Illustrative variable names only. Enter real values in the selected host's
# secret manager. Do not save production credentials in this example or Git.
RAILS_ENV=production
APP_HOST=planterapp.co
APP_ADDITIONAL_HOSTS=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
SECRET_KEY_BASE=
DATABASE_URL=
DB_SSLMODE=require
RAILS_MAX_THREADS=3
WEB_CONCURRENCY=1
PORT=3000
RAILS_LOG_LEVEL=info
ISP_DEMO_MODE=false
STORAGE_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for an S3-compatible provider; HTTPS only.
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
# Account-email sending remains disabled until approved sender verification and delivery drills.
ISP_ACCOUNT_EMAILS_ENABLED=false
ISP_ACCOUNT_EMAIL_DISPATCHER_ENABLED=false
MAIL_FROM=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=
# Private-network clamd, with current signatures and TZ=UTC. No public listener.
CLAMD_HOST=
CLAMD_PORT=3310
# PostgreSQL CI only. Never point at production; omit for local SQLite tests.
# TEST_DATABASE_URL=

# Set the verified, authorized first administrator only during controlled bootstrap.
# Bootstrap confirmation is supplied separately by the authorized operator.
ISP_BOOTSTRAP_ADMIN_EMAIL=
# Configure only during an approved, audited lost-authenticator recovery operation.
ISP_MFA_RECOVERY_ADMIN_EMAIL=